# ---- Neon Postgres ----
# Copy this file to .env.local and paste your Neon connection string.
# Neon dashboard -> your project -> Connection Details -> "Pooled connection".
# Keep ?sslmode=require on the end.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- App ----
NEXT_PUBLIC_APP_NAME="Vhagar POS"
NEXT_PUBLIC_CURRENCY="₹"
# Simple shared PIN to gate the admin screen at the booth (change me)
ADMIN_PIN="2026"

# ---- Vhagar IMS (Google Apps Script) — live product photos (+ optional stock) ----
# The deployed web-app /exec URL (Apps Script: Deploy > Manage deployments > Edit >
# New version; Execute as: Me; Who has access: Anyone — NOT "Anyone with Google
# account", or the POS gets an HTML login page instead of JSON). Server-side only:
# GAS sets no CORS. Leave blank to disable (photos fall back to letter tiles).
GAS_STOCK_URL=""
# Shared secret sent as ?token= (GAS can't read custom headers). Must equal the
# token in the Apps Script. NEVER prefix NEXT_PUBLIC_ — this stays server-only.
GAS_API_TOKEN=""
